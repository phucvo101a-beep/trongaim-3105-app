# ==============================================================================
# Tobi AIM SERVER KEY - PRODUCTION ENVIRONMENT CONFIGURATION
# Place this file OUTSIDE public web root (e.g. /home/user/.env or /etc/tobiaim3105/.env)
# Generate keys via: cargo run --manifest-path tools/keygen/Cargo.toml
# ==============================================================================

# 32-byte X25519 static private key (64 hex chars) - KEEP SECRET ON SERVER ONLY
SERVER_X25519_PRIV_HEX=REPLACE_WITH_64_HEX_X25519_PRIV

# 32-byte Ed25519 signing seed / private key (64 hex chars) - KEEP SECRET ON SERVER ONLY
SERVER_ED25519_PRIV_HEX=REPLACE_WITH_64_HEX_ED25519_PRIV

# Shared application pepper mixed into HKDF & HMAC client proofs (match GitHub Secret SEC_PEPPER)
PRE_SHARED_PEPPER=REPLACE_WITH_HIGH_ENTROPY_PEPPER

# 32-byte master key used to encrypt V4 .3105 assets in CI & derive per-bundle session keys (match SEC_BUNDLE_MASTER_KEY)
BUNDLE_PATCH_MASTER_KEY_HEX=REPLACE_WITH_64_HEX_BUNDLE_MASTER_KEY

# HMAC secret shared with GitHub Actions to authenticate CI build hash registration (match SEC_CI_SYNC_SECRET)
CI_SYNC_SECRET=REPLACE_WITH_64_HEX_CI_SYNC_SECRET

# Storage directory outside public web root (recommended!)
SERVERKEY_DATA_DIR=/var/lib/tobiaim3105-data

# Optional Rust core daemon / CLI binary path
RUST_CORE_MODE=auto
RUST_CORE_URL=http://127.0.0.1:8787
RUST_CORE_BIN=/usr/local/bin/serverkey_core
RUST_CORE_IPC_SECRET=REPLACE_WITH_INTERNAL_IPC_SECRET

# Admin credentials (bcrypt/argon2 hash generated via `php -r "echo password_hash('...', PASSWORD_ARGON2ID);"` )
ADMIN_USERNAME=tobiaim_admin
ADMIN_PASS_HASH=REPLACE_WITH_PASSWORD_HASH

# Optional MySQL/MariaDB or SQLite DSN (leave empty to use locked atomic JSON storage)
DB_DSN=
DB_USER=
DB_PASS=
